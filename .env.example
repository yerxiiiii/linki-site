# 复制为 .env 后填写，再用 `node --env-file=.env server.js` 或 `npm run dev` 启动

# 公开站点和表单提交接口
PORT=3000

# 内部看板端口
ADMIN_PORT=3001

# 监听地址。生产通常用 0.0.0.0，本地可用 127.0.0.1
HOST=0.0.0.0

# SQLite 数据库文件位置。默认：项目根目录下 data/linki-leads.db
DB_PATH=

# 后台登录账号（必填；未配置时服务拒绝启动）
# Cookie：HttpOnly; SameSite=Strict; Path=/（关闭浏览器失效；服务重启需重新登录）
ADMIN_USER=linki_admin
ADMIN_PASSWORD=

# 提交限流
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000

# 位于 nginx / 负载均衡后面时设置，用于读取真实客户端 IP
# 单个 nginx 前置一般填 1；不确定时先留空
TRUST_PROXY=

# HTTPS 终止在反代后时，可强制后台 Session Cookie 带 Secure
# COOKIE_SECURE=1

# Meta Conversions API（服务端 Lead 上报）。
# 留空则完全不发送，不影响表单正常提交。
# 在 Meta Events Manager → 你的 Pixel → 设置 → Conversions API 生成
META_CAPI_TOKEN=
META_PIXEL_ID=28499637663005947
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0
