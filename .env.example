# 复制为 .env 后填写，再用 `node --env-file=.env server.js` 启动

# 公开站点和表单提交接口
PORT=3000

# 内部看板端口
ADMIN_PORT=3001

# 监听地址。生产通常用 0.0.0.0，本地可用 127.0.0.1
HOST=0.0.0.0

# SQLite 数据库文件位置。默认：项目根目录下 data/linki-leads.db
DB_PATH=

# 允许访问内部看板的 IP，多个用英文逗号分隔
ADMIN_ALLOWED_IPS=

# 本地开发可跳过 IP 白名单。生产环境不要开启。
# ADMIN_PUBLIC=1

# 提交限流
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000

# 位于 nginx / 负载均衡后面时设置，用于读取真实客户端 IP
# 单个 nginx 前置一般填 1；不确定时先留空
TRUST_PROXY=
